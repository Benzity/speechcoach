# Anthropic Claude API
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# 서버 실행 환경
HOST=127.0.0.1
PORT=8000

# CORS (frontend 도메인). 모두 허용 시 "*", 특정 도메인 콤마 구분:
# CORS_ORIGINS=https://your-app.netlify.app,https://other.example.com
CORS_ORIGINS=*

# 데이터 디렉토리
VIDEO_DIR=./data/videos
DB_PATH=./data/app.db

# Whisper 모델 (Phase 0 결정)
WHISPER_MODEL=large-v3
WHISPER_COMPUTE_TYPE=float16
WHISPER_DEVICE=cuda
