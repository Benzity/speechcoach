# Anthropic Claude API
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# 서버 실행 환경
HOST=127.0.0.1
PORT=8000

# CORS (frontend 도메인). 모두 허용 시 "*", 특정 도메인 콤마 구분:
# CORS_ORIGINS=https://your-app.netlify.app,https://other.example.com
CORS_ORIGINS=*

# 인증 토큰 서명 키 (32바이트 이상 필수, RFC 7518 §3.2)
#   생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# 답변 영상 저장 암호화 키 (base64 인코딩된 32바이트 = AES-256)
#   개인정보의 안전성 확보조치 기준 제7조에 따른 저장 시 암호화용.
#   JWT_SECRET과 반드시 다른 값을 쓸 것 (용도별 키 분리).
#   ⚠️ 이 키를 잃어버리면 저장된 영상을 복호화할 수 없습니다.
#   생성: python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
VIDEO_ENCRYPTION_KEY=

# 프록시(ngrok·로드밸런서) 뒤에서 실제 클라이언트 IP를 얻으려면 true.
#   ⚠️ 신뢰할 수 있는 프록시 뒤에서만 켤 것 (헤더 위조로 IP 제한 우회 가능).
TRUST_PROXY_HEADERS=false

# 데이터 디렉토리
VIDEO_DIR=./data/videos
DB_PATH=./data/app.db

# Whisper 모델 (Phase 0 결정)
WHISPER_MODEL=large-v3
WHISPER_COMPUTE_TYPE=float16
WHISPER_DEVICE=cuda
